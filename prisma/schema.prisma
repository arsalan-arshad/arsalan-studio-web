generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  /** Support desk: inquiries + invite CLIENT/SUB_ADMIN; no client chat decrypt/access. */
  SUB_ADMIN
}

enum ThreadStatus {
  NEW
  ACTIVE
  CLOSED
}

enum InquiryStatus {
  NEW
  LINKED
  ARCHIVED
}

model User {
  id            String                   @id @default(cuid())
  email         String                   @unique
  /** Null for Google-only accounts (no local password). */
  passwordHash  String?
  name          String
  role          Role                     @default(CLIENT)
  /** When false, credentials / Google / Bearer auth are rejected. */
  active        Boolean                  @default(true)
  emailVerified DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  threads       Thread[]                 @relation("ClientThreads")
  messages      Message[]
  inquiries     Inquiry[]
  emailTokens   EmailVerificationToken[]
  resetTokens   PasswordResetToken[]
  bootstrapTokens AuthBootstrapToken[]
  refreshTokens RefreshToken[]
  accounts      Account[]
}

/**
 * Auth.js OAuth account link (Google). JWT sessions stay cookie-based;
 * this table records provider subject ↔ User for linking / future providers.
 */
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/** Opaque Bearer refresh tokens (sha256 at rest). Mobile / API clients only — not Auth.js cookies. */
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  /** Soft consume — kept briefly so double-submit / Strict Mode stays idempotent. */
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/** Password reset (1h) or admin invite set-password (7d). */
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** RESET | INVITE */
  purpose   String   @default("RESET")
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/** One-time web sign-in after email verify (no password in the verify link). */
model AuthBootstrapToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  company   String?
  needs     Json          @default("[]")
  otherNeed String?
  timeline  String?
  budget    String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  threadId  String?       @unique
  thread    Thread?       @relation(fields: [threadId], references: [id])
}

/**
 * Isolation boundary for chat: each client owns Threads; Messages belong to a Thread.
 * One shared Message table (not per-user tables) — filter by thread membership in every API.
 */
model Thread {
  id        String       @id @default(cuid())
  subject   String
  status    ThreadStatus @default(NEW)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  clientId  String
  client    User         @relation("ClientThreads", fields: [clientId], references: [id])
  inquiry   Inquiry?
  messages  Message[]

  @@index([clientId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  threadId       String
  thread         Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  /**
   * Message text. When bodyVersion=1 this is AES-256-GCM ciphertext (base64);
   * decrypt with CHAT_ENCRYPTION_SECRET + bodyNonce for authorized participants only.
   */
  body           String
  /** Base64 12-byte IV for AES-GCM (null when bodyVersion=0 plaintext legacy). */
  bodyNonce      String?
  /** 0 = plaintext (legacy / no secret); 1 = AES-256-GCM ciphertext in body. */
  bodyVersion    Int      @default(0)
  attachmentName String?
  /** Base64 IV when attachmentNameVersion=1. */
  attachmentNameNonce   String?
  /** 0 = plaintext filename; 1 = AES-GCM ciphertext in attachmentName. */
  attachmentNameVersion Int      @default(0)
  attachmentUrl  String?
  attachmentSize Int?
  createdAt      DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([threadId, id])
  @@index([senderId])
}
