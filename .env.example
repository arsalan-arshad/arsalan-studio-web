# Copy to .env / .env.local — never commit real secrets.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_DOMAIN=arsalandev.studio

# Free analytics (Google Analytics 4) — leave empty to disable script
# Create a GA4 property → Admin → Data streams → Web → Measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
# Optional later: PostHog free tier for product analytics / mobile continuity (not required)

# Postgres (local Docker default from repo docker-compose.yml)
# Railway: attach Postgres plugin → copy DATABASE_URL into the web service
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public

# Auth.js (required). Generate: openssl rand -base64 32
# Also used as HMAC secret for mobile/API *access* JWTs (1h TTL).
# Refresh tokens are opaque random strings stored sha256-hashed in RefreshToken — not JWTs.
AUTH_SECRET=replace-with-long-random-string
AUTH_URL=http://localhost:3000
# Railway first deploy: AUTH_URL=https://YOUR-SERVICE.up.railway.app
# After DNS: AUTH_URL=https://arsalandev.studio
# Bearer clients: POST /api/auth/token|register|refresh|logout — see README “Auth model”

# Google OAuth (optional — enables “Continue with Google” on /login and /signup)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: AUTH_URL (e.g. https://arsalandev.studio)
# Authorized redirect URIs: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Railway: set the same two vars on the web service after creating the OAuth client.

# Seed admin (npm run db:seed)
ADMIN_EMAIL=admin@arsalandev.studio
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Arsalan Arshad

# Email (Resend) — verification, password reset, contact notify
# From address (domain must be verified in Resend)
EMAIL_FROM=noreply@arsalandev.studio
CONTACT_TO_EMAIL=arsalanarshad.dev@gmail.com
CONTACT_NOTIFY_TO=arsalanarshad.dev@gmail.com
# Legacy alias — EMAIL_FROM is preferred
# CONTACT_FROM_EMAIL=noreply@arsalandev.studio
# RESEND_API_KEY=

# Chat message encryption at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Required in production so Message.body is ciphertext in Postgres dumps.
# Server decrypts only in authorized thread APIs (CLIENT own threads + ADMIN).
# SUB_ADMIN never receives decrypted chat. This is NOT zero-knowledge E2E —
# the server can read messages for admin support. See README “Chat encryption”.
CHAT_ENCRYPTION_SECRET=replace-with-long-random-string

# Cloudflare R2 (private chat attachments) — free tier ~10 GB
# Create bucket + API token (Object Read & Write) in Cloudflare dashboard
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=arsalan-studio-uploads
# Do NOT make the bucket public — downloads use short-lived signed URLs

